{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebApp",
  "version": "0.1.0",
  "identifier": "com.nordix.webapp",
  "build": {},
  "app": {
    "windows": [
      {
        "title": "WebApp",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "https://example.com"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Network",
    "shortDescription": "Webview wrapper",
    "longDescription": "A lightweight Tauri-based webview wrapper."
  }
}
